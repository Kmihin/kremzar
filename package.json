{
  "name": "kmetija-kremzar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "wrangler types && astro preview",
    "check": "wrangler types && astro check",
    "test": "wrangler types && vitest run",
    "format": "prettier --write .",
    "db:migrate:local": "wrangler d1 migrations apply kremzar --local",
    "db:seed:local": "wrangler d1 execute kremzar --local --file=seed/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.9.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "@types/node": "22.20.5"
  }
}
