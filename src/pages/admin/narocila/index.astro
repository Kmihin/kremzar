---
import AdminTable from "../../../components/AdminTable.astro";
import Badge from "../../../components/Badge.astro";
import Button from "../../../components/Button.astro";
import EmptyState from "../../../components/EmptyState.astro";
import SelectField from "../../../components/SelectField.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
  loadOrderList,
  orderStatusLabel,
  orderStatusOptions,
} from "../../../services/adminOrderService";
import { formatPrice } from "../../../services/formatService";

const { round, status, roundOptions, orders } = await loadOrderList(
  Number(Astro.url.searchParams.get("krog") ?? ""),
  Astro.url.searchParams.get("stanje") ?? "",
);
---

<AdminLayout title="Naročila">
  {round === null ? (
    <EmptyState>Ni še nobenega kroga.</EmptyState>
  ) : (
    <div class="admin-orders">
      <form class="admin-orders-filter" method="GET">
        <SelectField
          label="Krog"
          name="krog"
          value={String(round.id)}
          options={roundOptions}
        />
        <SelectField
          label="Stanje"
          name="stanje"
          value={status}
          options={orderStatusOptions}
        />
        <Button variant="outline">Prikaži</Button>
      </form>

      {orders.length === 0 ? (
        <EmptyState>Ni naročil.</EmptyState>
      ) : (
        <AdminTable>
          <table>
            <thead>
              <tr>
                <th>Kupec</th>
                <th>Skupaj</th>
                <th>Stanje</th>
              </tr>
            </thead>
            <tbody>
              {orders.map((order) => (
                <tr>
                  <td>
                    <a href={`/admin/narocila/${order.id}`}>
                      {order.customerName}
                    </a>
                    {order.phone !== null && (
                      <a class="admin-orders-phone" href={`tel:${order.phone}`}>
                        {order.phone}
                      </a>
                    )}
                  </td>
                  <td>{formatPrice(order.totalCents)}</td>
                  <td>
                    <Badge variant="outline">
                      {orderStatusLabel(order.status)}
                    </Badge>
                    <span class="admin-orders-paid">
                      {order.isPaid === 1 ? "Plačano" : "Neplačano"}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </AdminTable>
      )}
    </div>
  )}
</AdminLayout>

<style>
  .admin-orders {
    display: grid;
    gap: var(--space-6);
  }

  .admin-orders-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-4);
  }

  .admin-orders-phone,
  .admin-orders-paid {
    display: block;
    margin-top: var(--space-1);
    color: var(--color-text-soft);
    font-size: var(--text-xs);
  }
</style>
