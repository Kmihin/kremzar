---
// Page frame for the admin: plain, phone-first, never indexed.
import "../styles/global.css";
import { actions } from "astro:actions";
import NavList from "../components/NavList.astro";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  title: string;
  showMenu?: boolean;
}

const { title, showMenu = true } = Astro.props;
const adminLinks = [
  { href: "/admin/krogi", label: "Krogi" },
  { href: "/admin/narocila", label: "Naročila" },
  { href: "/admin/izdelki", label: "Izdelki" },
  { href: "/admin/novice", label: "Novice" },
  { href: "/admin/galerija", label: "Galerija" },
];
---

<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="admin-header">
      <div class="admin-header-inner">
        <a class="admin-home" href="/admin">
          <Wordmark size="header" />
          <span class="admin-home-label">Admin</span>
        </a>
        {showMenu && (
          <nav class="admin-nav" aria-label="Admin meni">
            <NavList links={adminLinks} layout="row" />
            <form method="POST" action={"/admin/odjava" + actions.admin.logout}>
              <button class="admin-logout" type="submit">
                Odjava
              </button>
            </form>
          </nav>
        )}
      </div>
    </header>
    <main class="admin-main">
      <h1 class="admin-title">{title}</h1>
      <slot />
    </main>
  </body>
</html>

<style>
  .admin-header {
    border-bottom: var(--border-width) solid var(--color-line);
    background-color: var(--color-white);
  }

  .admin-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    max-width: var(--admin-width);
    margin-inline: auto;
    padding: var(--space-2) var(--content-padding);
  }

  .admin-home {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    min-height: var(--touch-target);
    padding-top: var(--space-3);
    text-decoration: none;
  }

  .admin-home-label {
    color: var(--color-text-soft);
    font-size: var(--text-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  .admin-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-6);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .admin-nav :global(.nav-list-row) {
    gap: var(--space-1) var(--space-4);
  }

  .admin-logout {
    min-height: var(--touch-target);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-soft);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    cursor: pointer;
  }

  .admin-main {
    max-width: var(--admin-width);
    margin-inline: auto;
    padding: var(--space-7) var(--content-padding) var(--space-10);
  }

  .admin-title {
    margin-bottom: var(--space-6);
    font-size: var(--text-3xl);
  }
</style>
