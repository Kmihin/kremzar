---
// Labelled text input or text area with an optional hint and error messages.
interface Props {
  label: string;
  name: string;
  id?: string;
  value: string;
  errors?: string[];
  hint?: string;
  multiline?: boolean;
  type?: "text" | "password" | "tel";
  inputmode?: "text" | "decimal" | "numeric" | "tel";
  autocomplete?: string;
  required?: boolean;
}

const {
  label,
  name,
  id,
  value,
  errors = [],
  hint,
  multiline = false,
  type = "text",
  inputmode = "text",
  autocomplete = "off",
  required = false,
} = Astro.props;
const inputId = id ?? `field-${name}`;
const hintId = `${inputId}-hint`;
const errorId = `${inputId}-error`;
const hasErrors = errors.length > 0;
const describedBy =
  [hint === undefined ? "" : hintId, hasErrors ? errorId : ""]
    .filter((part) => part !== "")
    .join(" ") || undefined;
---

<div class:list={["field", { "has-error": hasErrors }]}>
  <label class="field-label" for={inputId}>
    {label}
  </label>
  {multiline ? (
    <textarea
      class="field-control"
      id={inputId}
      name={name}
      rows="4"
      required={required}
      aria-invalid={hasErrors ? "true" : undefined}
      aria-describedby={describedBy}
      set:text={value}
    />
  ) : (
    <input
      class="field-control"
      id={inputId}
      name={name}
      type={type}
      value={value}
      inputmode={inputmode}
      autocomplete={autocomplete}
      required={required}
      aria-invalid={hasErrors ? "true" : undefined}
      aria-describedby={describedBy}
    />
  )}
  {hint !== undefined && (
    <p class="field-hint" id={hintId}>
      {hint}
    </p>
  )}
  {hasErrors && (
    <p class="field-error" id={errorId}>
      {errors.join(" ")}
    </p>
  )}
</div>

<style>
  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .field-control {
    width: 100%;
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-control-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
  }

  textarea.field-control {
    resize: vertical;
  }

  .field-hint {
    color: var(--color-text-soft);
    font-size: var(--text-sm);
  }

  .field-error {
    color: var(--color-error);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .has-error .field-control {
    border-color: var(--color-error);
  }
</style>
