---
// Sticky site header: wordmark and navigation. On phones the navigation sits
// in a disclosure menu that works without JavaScript.
import { site } from "../config/site";
import NavList from "./NavList.astro";
import Wordmark from "./Wordmark.astro";

const links = [...site.navLinks, site.orderLink];
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-header-home" href="/" aria-label={`${site.name}, domov`}>
      <Wordmark size="header" />
    </a>
    <nav class="site-header-nav-wide" aria-label="Glavni meni">
      <NavList links={links} layout="row" />
    </nav>
    <details class="site-header-menu">
      <summary class="site-header-menu-toggle">
        <span class="site-header-menu-closed">Meni</span>
        <span class="site-header-menu-open">Zapri</span>
      </summary>
      <nav aria-label="Glavni meni">
        <NavList links={links} layout="column" />
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: var(--border-width) solid var(--color-line);
    background-color: var(--color-header-bg);
    backdrop-filter: blur(var(--backdrop-blur));
  }

  .site-header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    max-width: var(--content-width);
    min-height: var(--header-height);
    margin-inline: auto;
    padding-inline: var(--content-padding);
  }

  .site-header-home {
    text-decoration: none;
  }

  .site-header-nav-wide,
  .site-header-nav-wide :global(.nav-list-link),
  .site-header-menu :global(.nav-list-link) {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .site-header-nav-wide {
    display: none;
  }

  /* The order link is the last item and stands out, as in the reference. */
  .site-header :global(li:last-child .nav-list-link) {
    color: var(--color-gold-ink);
    font-weight: var(--weight-semibold);
  }

  .site-header-menu-toggle {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .site-header-menu-toggle::-webkit-details-marker {
    display: none;
  }

  .site-header-menu-open,
  .site-header-menu[open] .site-header-menu-closed {
    display: none;
  }

  .site-header-menu[open] .site-header-menu-open {
    display: inline;
  }

  .site-header-menu nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    padding: var(--space-3) var(--content-padding) var(--space-5);
    border-block: var(--border-width) solid var(--color-line);
    background-color: var(--color-cream);
  }

  @media (min-width: 48rem) {
    .site-header-nav-wide {
      display: block;
    }

    .site-header-menu {
      display: none;
    }
  }
</style>
