---
// Shown when a list has nothing in it yet.
---

<p class="empty-state">
  <slot />
</p>

<style>
  .empty-state {
    max-width: var(--measure);
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-lg);
    background-color: var(--color-white);
    color: var(--color-text-soft);
  }
</style>
