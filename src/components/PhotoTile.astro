---
// Photo with a title and a short text, linking to a section of the site.
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  photo: ImageMetadata;
  title: string;
}

const { href, photo, title } = Astro.props;
---

<a class="photo-tile" href={href}>
  <span class="photo-tile-frame">
    <img
      src={photo.src}
      width={photo.width}
      height={photo.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </span>
  <h3 class="photo-tile-title">{title}</h3>
  <p class="photo-tile-text">
    <slot />
  </p>
</a>

<style>
  .photo-tile {
    display: block;
    text-decoration: none;
  }

  .photo-tile-frame {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .photo-tile img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--easing-standard);
  }

  .photo-tile:hover img {
    transform: scale(var(--hover-scale-soft));
  }

  .photo-tile-title {
    margin-top: var(--space-5);
    font-size: var(--text-2xl);
  }

  .photo-tile:hover .photo-tile-title {
    color: var(--color-gold-ink);
  }

  .photo-tile-text {
    margin-top: var(--space-2);
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
</style>
